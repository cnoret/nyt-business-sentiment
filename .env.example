# Copy to .env and fill in. Never commit .env.

# Free key from https://developer.nytimes.com (enable the Archive API).
NYT_API_KEY=

# Credentials of the local S3-compatible storage (RustFS) and PostgreSQL.
S3_ACCESS_KEY=nytadmin
S3_SECRET_KEY=nytadmin-secret
POSTGRES_PASSWORD=nyt

# Optional: Slack incoming webhook for the Streamlit monitoring DAG.
SLACK_WEBHOOK_URL=

# Host port for PostgreSQL (change it if 5432 is already taken).
POSTGRES_PORT=5432
